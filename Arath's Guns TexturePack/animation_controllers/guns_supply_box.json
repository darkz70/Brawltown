{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.guns_supply_box": {
      "initial_state": "fly_on",
      "states": {
        "fly_on": {
          "animations": [
            "fly_on"
          ],
          "transitions": [
            {
              "fly_off": "query.is_in_water || query.is_on_ground"
            }
          ]
        },
        "fly_off": {
          "animations": [
            "fly_off"
          ],
          "transitions": [
            {
              "fly_on": "!query.is_in_water && !query.is_on_ground"
            }
          ]
        }
      }
    }
  }
}
