{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.player.dual_pistol": {
      "states": {
        "default": {
          "blend_transition": 0.2,
          "transitions": [
            {
              "gun": "q.equipped_item_any_tag('slot.weapon.mainhand', 'dual_pistol')"
            }
          ]
        },
        "gun": {
          "animations": [
            "dual_pistol_hold"
          ],
          "blend_transition": 0.2,
