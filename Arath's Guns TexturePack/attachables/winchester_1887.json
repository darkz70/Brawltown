{
	"format_version": "1.16.100",
	"minecraft:attachable": {
		"description": {
			"identifier": "gunsaddon:winchester_1887",
			"materials": {
				"default": "entity_alphatest"
			},
			"textures": {
				"default": "textures/3d_guns/winchester_1887.png"
			},
			"geometry": {
				"default": "geometry.winchester_1887"
			},
			"render_controllers": [
				"controller.render.default"
			],
			"animations": {
				"first_person_main_hand": "animation.winchester_1887.first_person_main_hand",
				"first_person_sneaking_main_hand": "animation.winchester_1887.first_person_main_hand",
				"third_person_main_hand": "animation.winchester_1887.third_person_main_hand"
			},
			"scripts": {
				"pre_animation": [
					"v.main_hand = c.item_slot == 'main_hand';"
				],
				"animate": [
					{
						"first_person_main_hand": "(v.main_hand && c.is_first_person) && !query.is_sneaking"
					},
					{
						"first_person_sneaking_main_hand": "(v.main_hand && c.is_first_person) && query.is_sneaking"
					},
					{
						"third_person_main_hand": "v.main_hand && !c.is_first_person"
					}
				]
			}
		}
	}
} 